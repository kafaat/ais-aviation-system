# Full Docker Compose. Copy to .env.production, configure private values, then run
# docker compose --env-file .env.production -f docker-compose.production.yml config --quiet
# Compose builds the MySQL URLs for API, worker, migrator and auth from these values.
# Use URL-safe random credentials because DB_PASSWORD is also put in the connection URI.
DB_NAME=ais_aviation
DB_USER=ais_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Separate random secrets, at least 32 characters each (openssl rand -hex 32).
JWT_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
SELF_SERVICE_CAPABILITY_SECRET=CHANGE_ME
AUTH_SERVICE_TOKEN=CHANGE_ME
MFA_ENCRYPTION_KEY=CHANGE_ME
FRONTEND_URL=https://ais.example.com
TRUSTED_PROXIES=uniquelocal
# Optional. Set the same dedicated token at the scraper to enable Prometheus.
METRICS_TOKEN=

# Full Compose provisions shared Redis with noeviction. Override for a dedicated queue.
QUEUE_REDIS_URL=

# Match Stripe test/live mode, account and signing secret to the deployed endpoint.
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Resend accepts email only with both a key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Optional integrations. Supply the matching credentials and acceptance references
# documented in .env.example when enabling one of these modes.
HOTELBEDS_MODE=disabled
AVIATION_WEATHER_MODE=disabled
ONCALL_MODE=disabled
AIS_OTEL_ENABLED=false
