#!/bin/sh
# Pre-commit hook: format staged files with Prettier so CI does not fail on
# formatting. A file with unstaged hunks is left alone: formatting the
# working copy and re-adding it would commit hunks the author kept out of
# the index on purpose. A Prettier failure is shown and blocks the commit.
set -eu

git diff --cached --name-only --diff-filter=ACM \
  | { grep -E '\.(js|jsx|ts|tsx|json|css|scss|md|html|yaml|yml)$' || true; } \
  | while IFS= read -r file; do
      if ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes; not reformatting it"
        continue
      fi
      pnpm exec prettier --write --ignore-unknown -- "$file"
      git add -- "$file"
    done

echo "Prettier formatting applied to fully staged files."
