    "helmet": "^8.3.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "ioredis": "^5.11.1",
    "jose": "6.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.3",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "openai": "^4.104.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.6.6",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "streamdown": "^1.6.11",
    "stripe": "~20.2.0",
    "superjson": "^1.13.3",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "trpc-openapi": "^1.2.0",
    "uuid": "^13.0.2",
    "vaul": "^1.1.2",
    "web-vitals": "^4.2.4",
    "wouter": "^3.11.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^11.2.0",
    "@size-limit/webpack": "^11.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "4.17.21",
    "@types/google.maps": "^3.66.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "add": "^2.0.9",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.1.3",
    "pnpm": "^10.34.5",
    "postcss": "^8.5.28",
    "prettier": "~3.8.5",
    "rollup-plugin-visualizer": "^5.14.0",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "uuid": "^13.0.0",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-manus-runtime": "^0.0.56",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7",
      "nwsapi": "2.2.23",
      "serialize-javascript": ">=7.0.5",
      "qs": ">=6.16.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "exceljs>uuid": "^11.1.1"
    }
  },
  "size-limit": [
    {
      "name": "Main JS Bundle",
      "path": "dist/public/assets/index-*.js",
      "limit": "500 KB",
      "gzip": true
    },
    {
      "name": "Vendor Chunk",
      "path": "dist/public/assets/vendor-*.js",
      "limit": "300 KB",
      "gzip": true
    },
    {
      "name": "UI Components Chunk",
      "path": "dist/public/assets/ui-*.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "Charts Chunk",
      "path": "dist/public/assets/charts-*.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "name": "Total JS",
      "path": "dist/public/assets/*.js",
      "limit": "1.2 MB",
      "gzip": true
    },
    {
      "name": "Total CSS",
      "path": "dist/public/assets/*.css",
      "limit": "100 KB",
      "gzip": true
    }
  ]
}
