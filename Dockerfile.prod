# Use a smaller base image for production
FROM node:22-alpine AS base

# Security: Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 ais

# One package-manager version for builds, production dependencies and migrations.
# package.json is the source of truth; never install the registry's latest pnpm.
FROM base AS toolchain
WORKDIR /app
COPY package.json pnpm-lock.yaml .npmrc ./
RUN node -e 'if (!/^pnpm@\d+\.\d+\.\d+$/.test(require("./package.json").packageManager ?? "")) throw new Error("packageManager must pin pnpm@x.y.z")' && \
    npm install --global "$(node -p 'require("./package.json").packageManager')" && \
    test "$(pnpm --version)" = "$(node -p 'require("./package.json").packageManager.slice(5)')"

# Install build tools as well as runtime dependencies.
FROM toolchain AS deps
ENV NODE_ENV=development
RUN pnpm install --frozen-lockfile

# Build the application
FROM deps AS builder
ENV NODE_ENV=production
WORKDIR /app
COPY . .
RUN pnpm build

# Production dependencies only
FROM toolchain AS prod-deps
RUN pnpm install --frozen-lockfile --prod

# Migration image (includes drizzle-kit for running database migrations)
# Build with: docker build -f Dockerfile.prod --target migrator -t app-migrator .
FROM deps AS migrator
WORKDIR /app
COPY drizzle ./drizzle
COPY drizzle.config.ts ./
USER ais
CMD ["./node_modules/.bin/drizzle-kit", "migrate"]

# Production image
FROM base AS runner
WORKDIR /app

# Copy production dependencies only (smaller image)
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Copy built application (includes dist/public for serving client assets)
COPY --from=builder /app/dist ./dist

# Expose the port
EXPOSE 3000

# Set production environment
ENV NODE_ENV=production

# Security: Run as non-root user
USER ais

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/trpc/health.check').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

# Start the application
CMD ["node", "dist/index.js"]
